-- ==========================================
-- Driving Empire: Control Key Instant Snap Launch + Auto-Save UI Position (Fixed Crash)
-- ==========================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 🧹 1. ป้องกันลูปเก่าค้าง & ล้าง UI เก่าทิ้งก่อนสร้างใหม่เพื่อไม่ให้กินแรม
getgenv().RunningCarTuner = false
task.wait(0.1)
getgenv().RunningCarTuner = true
getgenv().TunerActive = false

pcall(function()
    if PlayerGui:FindFirstChild("CarTunerUI") then
        PlayerGui.CarTunerUI:Destroy()
    end
end)

getgenv().TargetSpeed = 300 -- ความเร็วเป้าหมายที่จะพุ่งไปทันทีเมื่อกด Ctrl

local function getMyCurrentCar()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local seat = hum.SeatPart
        local car = seat.Parent
        while car and not car:IsA("Model") do car = car.Parent end
        return car, seat
    end
    return nil, nil
end

-- 🖥️ สร้าง UI แผงควบคุม พร้อมระบบจำตำแหน่งล่าสุด
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CarTunerUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 130)

-- 💾 ไฟล์สำหรับบันทึกตำแหน่ง UI (ปลอดภัยต่อ Executor ที่ไม่รองรับระบบไฟล์)
local saveFileName = "CarTunerUIPos.json"
local defaultPosition = UDim2.new(0.02, 0, 0.25, 0)

pcall(function()
    if writefile and readfile and isfile and isfile(saveFileName) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(saveFileName))
        end)
        if success and decoded and decoded.X and decoded.Y then
            mainFrame.Position = UDim2.new(decoded.X.Scale, decoded.X.Offset, decoded.Y.Scale, decoded.Y.Offset)
        else
            mainFrame.Position = defaultPosition
        end
    else
        mainFrame.Position = defaultPosition
    end
end)

mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 8)
mainCorner.Parent = mainFrame

-- 💾 บันทึกตำแหน่งอัตโนมัติเมื่อลากหน้าต่างวางเสร็จ (ครอบ pcall ป้องกัน error)
mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        pcall(function()
            if writefile then
                local pos = mainFrame.Position
                local data = {
                    X = { Scale = pos.X.Scale, Offset = pos.X.Offset },
                    Y = { Scale = pos.Y.Scale, Offset = pos.Y.Offset }
                }
                writefile(saveFileName, HttpService:JSONEncode(data))
            end
        end)
    end
end)

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 200, 0, 35)
toggleButton.Position = UDim2.new(0, 10, 0, 10)
toggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextSize = 14
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Text = "CTRL LAUNCH: OFF"
toggleButton.Parent = mainFrame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = toggleButton

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(0, 200, 0, 25)
speedLabel.Position = UDim2.new(0, 10, 0, 52)
speedLabel.BackgroundTransparency = 1
speedLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
speedLabel.TextSize = 13
speedLabel.Font = Enum.Font.Gotham
speedLabel.Text = "Target Speed: 300"
speedLabel.Parent = mainFrame

local sliderBg = Instance.new("TextButton")
sliderBg.Size = UDim2.new(0, 200, 0, 12)
sliderBg.Position = UDim2.new(0, 10, 0, 88)
sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
sliderBg.Text = ""
sliderBg.Parent = mainFrame

local sliderCorner = Instance.new("UICorner")
sliderCorner.CornerRadius = UDim.new(0, 6)
sliderCorner.Parent = sliderBg

local sliderFill = Instance.new("Frame")
sliderFill.Size = UDim2.new(300 / 600, 0, 1, 0)
sliderFill.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
sliderFill.BorderSizePixel = 0
sliderFill.Parent = sliderBg

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 6)
fillCorner.Parent = sliderFill

local dragging = false

local function updateSlider(input)
    local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
    getgenv().TargetSpeed = math.floor(pos * 600)
    sliderFill.Size = UDim2.new(pos, 0, 1, 0)
    speedLabel.Text = "Target Speed: " .. getgenv().TargetSpeed
end

sliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(input)
    end
end)

local isCtrlPressed = false

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.LeftControl then
        isCtrlPressed = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftControl then
        isCtrlPressed = false
    end
end)

-- ⚙️ ระบบคำนวณความเร็ว (เพิ่มเงื่อนไขเช็คสถานะการทำงานเพื่อกันเกมกระตุกและหลุด)
RunService.Heartbeat:Connect(function()
    if not getgenv().RunningCarTuner then return end
    if not getgenv().TunerActive then return end
    if not isCtrlPressed then return end

    local car, seat = getMyCurrentCar()
    if not car or not seat then return end

    local primaryPart = car.PrimaryPart or seat
    if not primaryPart or primaryPart.Anchored then return end

    local currentVel = primaryPart.AssemblyLinearVelocity
    local lookVector = primaryPart.CFrame.LookVector
    
    local snapSpeed = getgenv().TargetSpeed * 0.85
    local targetVelocity = (lookVector * snapSpeed) + Vector3.new(0, math.min(currentVel.Y, 0), 0)
    
    primaryPart.AssemblyLinearVelocity = targetVelocity
end)

local function toggleTuner()
    getgenv().TunerActive = not getgenv().TunerActive
    if getgenv().TunerActive then
        toggleButton.Text = "CTRL LAUNCH: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
    else
        toggleButton.Text = "CTRL LAUNCH: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        isCtrlPressed = false
    end
end

toggleButton.MouseButton1Click:Connect(toggleTuner)

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.RightControl then
        toggleTuner()
    end
end)
