end)

-- 🖥️ สร้างปุ่ม UI ควบคุม พร้อมระบบจำตำแหน่งล่าสุด
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "HighwayFarmUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ToggleButton"
toggleButton.Size = UDim2.new(0, 160, 0, 40)

-- 💾 โหลดตำแหน่งที่เคยลากวางไว้ล่าสุด
local saveFileName = "HighwayFarmUIPos.json"
local defaultPosition = UDim2.new(0.015, 0, 0.22, 0)

pcall(function()
    if readfile and isfile and isfile(saveFileName) then
        local data = HttpService:JSONDecode(readfile(saveFileName))
        if data and data.X and data.Y then
            toggleButton.Position = UDim2.new(data.X.Scale, data.X.Offset, data.Y.Scale, data.Y.Offset)
        else
            toggleButton.Position = defaultPosition
        end
    else
        toggleButton.Position = defaultPosition
    end
end)

if toggleButton.Position == UDim2.new(0, 0, 0, 0) then
    toggleButton.Position = defaultPosition
end

toggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextSize = 14
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Text = "AUTO DRIVE: OFF"
toggleButton.Active = true
toggleButton.Draggable = true
toggleButton.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = toggleButton

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(80, 80, 80)
stroke.Thickness = 1
stroke.Parent = toggleButton

-- 💾 บันทึกตำแหน่งอัตโนมัติเมื่อปล่อยเมาส์จากการลากปุ่ม
toggleButton.MouseButton1Up:Connect(function()
    pcall(function()
        if writefile then
            local pos = toggleButton.Position
            local data = {
                X = { Scale = pos.X.Scale, Offset = pos.X.Offset },
                Y = { Scale = pos.Y.Scale, Offset = pos.Y.Offset }
            }
            writefile(saveFileName, HttpService:JSONEncode(data))
        end
    end)
end)

-- 🚗 ระบบขับเคลื่อนความเร็วเสถียร
local function startAutoDrive()
    task.spawn(function()
        while AutoFarmActive and getgenv().RunningHighwayFarm do
            local car, seat = getMyCurrentCar()

            if not car then
                notify("Auto Drive", "กรุณาขึ้นรถก่อนเปิดใช้งาน!")
                AutoFarmActive = false
                toggleButton.Text = "AUTO DRIVE: OFF"
                toggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                break
            end

            -- 1. วาร์ปตั้งลำที่จุด A
            resetPhysics(car)
            car:PivotTo(PointA)
            task.wait(0.4)

            -- 2. กดคันเร่ง W ค้างไว้
            pressKey(Enum.KeyCode.Space, false)
            pressKey(Enum.KeyCode.S, false)
            pressKey(Enum.KeyCode.W, true)

            local primaryPart = car.PrimaryPart or seat
            local startPos = PointA.Position
            local endPos = PointB.Position
            local totalDistance = (endPos - startPos).Magnitude
            
            local duration = totalDistance / targetSpeed
            local startTime = tick()
            local direction = (endPos - startPos).Unit

            while AutoFarmActive and getgenv().RunningHighwayFarm do
                local elapsed = tick() - startTime
                local currentCar = getMyCurrentCar()
                if not currentCar or not primaryPart then break end
                
                local alpha = elapsed / duration
                if alpha >= 1 then break end

                local currentPos = startPos:Lerp(endPos, alpha)
                local lookVector = (endPos - startPos).Unit

                -- ยิง Raycast จับระดับพื้นสะพานให้รถวิ่งแนบสนิท
                local raycastParam = RaycastParams.new()
                raycastParam.FilterDescendantsInstances = {car}
                raycastParam.FilterType = Enum.RaycastFilterType.Exclude

                local rayResult = workspace:Raycast(currentPos + Vector3.new(0, 15, 0), Vector3.new(0, -40, 0), raycastParam)
                local groundY = rayResult and rayResult.Position.Y or currentPos.Y
                local perfectPos = Vector3.new(currentPos.X, groundY + 0.15, currentPos.Z)

                -- ล็อกความเร็วและบังคับมุมองศาให้อยู่กลางเลน
                primaryPart.AssemblyLinearVelocity = Vector3.new(direction.X * targetSpeed, primaryPart.AssemblyLinearVelocity.Y, direction.Z * targetSpeed)
                car:PivotTo(CFrame.new(perfectPos, perfectPos + lookVector) * CFrame.Angles(0, math.rad(28.1), 0))
                resetPhysics(currentCar)

                RunService.Heartbeat:Wait()
            end

            pressKey(Enum.KeyCode.W, false)

            if not AutoFarmActive or not getgenv().RunningHighwayFarm then break end
            
            if primaryPart then
                primaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            task.wait(0.4)
        end

        pressKey(Enum.KeyCode.W, false)
    end)
end

local function toggleDrive()
    AutoFarmActive = not AutoFarmActive
    if AutoFarmActive then
        toggleButton.Text = "AUTO DRIVE: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        startAutoDrive()
    else
        toggleButton.Text = "AUTO DRIVE: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    end
end

toggleButton.MouseButton1Click:Connect(toggleDrive)

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.End then
        toggleDrive()
    end
end)
