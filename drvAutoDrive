local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local VirtualUser = game:GetService("VirtualUser")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 🧹 ล้าง UI เก่าทิ้งก่อนสร้างใหม่
pcall(function()
    if PlayerGui:FindFirstChild("HighwayFarmUI") then
        PlayerGui.HighwayFarmUI:Destroy()
    end
end)

getgenv().RunningHighwayFarm = false
task.wait(0.1)
getgenv().RunningHighwayFarm = true

local AutoFarmActive = false

-- ⚙️ ปรับความเร็วให้อยู่ในโซนเสถียร (เงินขึ้นชัวร์ ไม่ดีดเกินลิมิต)
local targetSpeed = 500 

-- 📍 จุดเริ่มต้น (Point A) และจุดสิ้นสุด (Point B) พร้อมปรับมุมองศาให้ตรงล็อกกลางเลน
local PointA = CFrame.new(-18855.3, 37.0, -1751.2) * CFrame.Angles(0, math.rad(28.1), 0)
local PointB = CFrame.new(-34364.7, 33.8, -32477.5) * CFrame.Angles(0, math.rad(28.1), 0)

local function notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = title, Text = text, Duration = 3 })
    end)
end

local function pressKey(keyCode, state)
    pcall(function()
        VirtualInputManager:SendKeyEvent(state, keyCode, false, game)
    end)
end

local function getMyCurrentCar()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local seat = hum.SeatPart
        local car = seat.Parent
        while car and not car:IsA("Model") do car = car.Parent end
        return car, seat
    end
    return nil, nil
end

local function resetPhysics(car)
    if car and car.PrimaryPart then
        for _, part in pairs(car:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end

-- 🛡️ ระบบ Anti-AFK ทำงานอัตโนมัติป้องกันโดนเตะออกจากเกม
task.spawn(function()
    while getgenv().RunningHighwayFarm do
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(500, 500))
        end)
