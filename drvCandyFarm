-- ⚙️ ฟังก์ชันเช็กตัวละคร
local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- 📌 ฟังก์ชันฟาร์มแคนดี้
local function farmAllCandyAtLocation(targetCFrame)
    local root = getRoot()
    if not root then return end

    root.CFrame = targetCFrame + Vector3.new(0, 8, 0)
    task.wait(1)

    while _G.AutoFarmActive do
        local foundCandy = false
        root = getRoot()
        if not root then break end

        for _, obj in ipairs(candyFolder:GetDescendants()) do
            if not _G.AutoFarmActive then break end
            
            if obj:IsA("MeshPart") and obj.Parent then
                foundCandy = true
                
                root.CFrame = obj.CFrame + Vector3.new(0, 8, 0)
                task.wait(0.08)
                
                local timeout = 0
                repeat
                    task.wait(0.05)
                    timeout = timeout + 0.05
                until not obj.Parent or timeout >= 0.5 or not _G.AutoFarmActive
                
                task.wait(0.05)
            end
        end

        if not foundCandy or not _G.AutoFarmActive then
            break
        end

        task.wait(0.5)
    end
end

-- 🚀 ลูปหลัก
task.spawn(function()
    while true do
        if _G.AutoFarmActive then
            for i, pos in ipairs(locations) do
                if not _G.AutoFarmActive then break end
                farmAllCandyAtLocation(CFrame.new(pos))
                task.wait(1)
            end
        end
        task.wait(0.5)
    end
end)
