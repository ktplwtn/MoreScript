-- 🖱️ ระบบลาก UI
local dragging = false
local mousePos, framePos

titleLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        mousePos = input.Position
        framePos = mainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - mousePos
        mainFrame.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
    end
end)

-- ปุ่มเปิด/ปิด
toggleButton.MouseButton1Click:Connect(function()
    _G.AutoFarmActive = not _G.AutoFarmActive
    if _G.AutoFarmActive then
        toggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        toggleButton.Text = "Status: ON 🟢"
    else
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        toggleButton.Text = "Status: OFF 🔴"
    end
end)

-- ⚙️ ฟังก์ชันเช็กตัวละคร
local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- 📌 ฟังก์ชันฟาร์มแคนดี้ (เพิ่มระยะความสูงตอนวาร์ปให้ปล่อยตัวตกลงมาก่อน)
local function farmAllCandyAtLocation(targetCFrame)
    local root = getRoot()
    if not root then return end

    -- วาร์ปมาถึงพื้นที่ (สูงขึ้นเล็กน้อยเผื่อจังหวะโหลดแมพ)
    root.CFrame = targetCFrame + Vector3.new(0, 8, 0)
    task.wait(1)

    while _G.AutoFarmActive do
        local foundCandy = false
        root = getRoot()
        if not root then break end

        for _, obj in ipairs(candyFolder:GetDescendants()) do
            if not _G.AutoFarmActive then break end
            
            if obj:IsA("MeshPart") and obj.Parent then
                foundCandy = true
                
                -- 🪂 ปรับจุดวาร์ปให้อยู่เหนือตัวแคนดี้สูงขึ้น (เช่น +8 Studs) เพื่อให้มีจังหวะตกลงมาเก็บ
                root.CFrame = obj.CFrame + Vector3.new(0, 8, 0)
                task.wait(0.08) -- หน่วงเวลาสั้นๆ ให้ตัวละครร่วงลงมาแตะแคนดี้พอดี
                
                local timeout = 0
                repeat
                    task.wait(0.05)
                    timeout = timeout + 0.05
                until not obj.Parent or timeout >= 0.5 or not _G.AutoFarmActive
                
                task.wait(0.05)
            end
        end

        if not foundCandy or not _G.AutoFarmActive then
            break
        end

        task.wait(0.5)
    end
end

-- 🚀 ลูปหลัก: สลับวาร์ปไปตามสถานที่ต่างๆ
task.spawn(function()
    while true do
        if _G.AutoFarmActive then
            for i, pos in ipairs(locations) do
                if not _G.AutoFarmActive then break end
                farmAllCandyAtLocation(CFrame.new(pos))
                task.wait(1)
            end
        end
        task.wait(0.5)
    end
end)
