local function showNotification(text)
    notifyLabel.Text = text
    notifyLabel.TextTransparency = 0
    notifyLabel.BackgroundTransparency = 0.2
    task.spawn(function()
        task.wait(1.5)
        for i = 0, 1, 0.1 do
            notifyLabel.TextTransparency = i
            notifyLabel.BackgroundTransparency = 0.2 + (i * 0.8)
            task.wait(0.05)
        end
        notifyLabel.TextTransparency = 1
        notifyLabel.BackgroundTransparency = 1
    end)
end

-- ⌨️ กดปุ่ม Insert หรือ RightControl เพื่อซ่อน/แสดง UI
